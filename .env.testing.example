APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=4
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Default test DB — SQLite in-memory. CI overrides to MySQL via env vars.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=array
BROADCAST_CONNECTION=null

MAIL_MAILER=array
