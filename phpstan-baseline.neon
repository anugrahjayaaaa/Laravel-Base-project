parameters:
	ignoreErrors:
		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 1
			path: app/Console/Commands/AuditPurgeCommand.php

		-
			message: '#^Call to method user\(\) on an unknown class App\\Http\\Requests\\Auth\\PasswordChangeRequest\.$#'
			identifier: class.notFound
			count: 2
			path: app/Http/Controllers/Api/AuthController.php

		-
			message: '#^Call to method validated\(\) on an unknown class App\\Http\\Requests\\Auth\\PasswordChangeRequest\.$#'
			identifier: class.notFound
			count: 1
			path: app/Http/Controllers/Api/AuthController.php

		-
			message: '#^Parameter \$request of method App\\Http\\Controllers\\Api\\AuthController\:\:changePassword\(\) has invalid type App\\Http\\Requests\\Auth\\PasswordChangeRequest\.$#'
			identifier: class.notFound
			count: 1
			path: app/Http/Controllers/Api/AuthController.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$created_at\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Controllers/AuditController.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$description\.$#'
			identifier: property.notFound
