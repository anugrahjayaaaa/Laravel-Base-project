		-
			message: '#^Cannot call method diffInSeconds\(\) on string\.$#'
			identifier: method.nonObject
			count: 1
			path: app/Http/Controllers/Auth/LoginController.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Builder\<TRelatedModel of Illuminate\\Database\\Eloquent\\Model\>\:\:active\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Http/Controllers/BillingAdminController.php

		-
			message: '#^Relation ''licenses'' is not found in App\\Models\\User model\.$#'
			identifier: larastan.relationExistence
			count: 1
			path: app/Http/Controllers/BillingAdminController.php

		-
			message: '#^Parameter \#2 \$default of static method App\\Models\\Setting\:\:get\(\) expects string\|null, false given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/SettingsController.php

		-
			message: '#^Parameter \#2 \$default of static method App\\Models\\Setting\:\:get\(\) expects string\|null, false given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Middleware/RegistrationEnabled.php

		-
			message: '#^Method App\\Http\\Requests\\Auth\\PasswordResetRequest\:\:rules\(\) should return array\<string, string\> but returns array\<string, list\<string\>\|string\>\.$#'
			identifier: return.type
			count: 1
			path: app/Http/Requests/Auth/PasswordResetRequest.php

		-
			message: '#^Using nullsafe property access "\?\-\>id" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Http/Requests/Plan/PlanRequest.php

		-
			message: '#^Method App\\Http\\Requests\\Profile\\ProfileUpdateRequest\:\:rules\(\) should return array\<string, string\> but returns array\<string, list\<Illuminate\\Validation\\Rules\\Unique\|string\>\|string\>\.$#'
